# Production deployment must use an audited fixed tag.
# Using :latest in production is forbidden.
APP_IMAGE=ghcr.io/ywain-zh/microsoft-account-manager:2026.04.18-4
PORT=8787
HOST=0.0.0.0
DB_PATH=/app/data/account-manager.db
PUBLIC_DIR=/app/dist
MIGRATIONS_DIR=/app/migrations
# Optional: only set when importing a legacy local SQLite directory
LEGACY_DB_DIR=
AUTO_IMPORT_LEGACY_DB=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
SESSION_SECRET=change-me
INGEST_TOKEN=change-me
MAIL_API_TOKEN=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=consumers
MS_REDIRECT_URI=https://mail.0222999.xyz/auth/microsoft/callback
